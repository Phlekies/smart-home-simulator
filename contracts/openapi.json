      "PlanReference-Input": {
        "properties": {
          "file_name": {
            "type": "string",
            "maxLength": 255,
            "minLength": 1,
            "title": "File Name"
          },
          "media_type": {
            "type": "string",
            "enum": [
              "image/png",
              "image/jpeg",
              "image/webp"
            ],
            "title": "Media Type"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "title": "Sha256",
            "description": "SHA-256 of the image file bytes"
          },
          "width_px": {
            "type": "integer",
            "maximum": 16384.0,
            "minimum": 1.0,
            "title": "Width Px"
          },
          "height_px": {
            "type": "integer",
            "maximum": 16384.0,
            "minimum": 1.0,
            "title": "Height Px"
          },
          "meters_per_pixel": {
            "type": "number",
            "maximum": 20000.0,
            "exclusiveMinimum": 0.0,
            "title": "Meters Per Pixel"
          },
          "origin_x_m": {
            "type": "number",
            "maximum": 10000.0,
            "minimum": -10000.0,
            "title": "Origin X M"
          },
          "origin_y_m": {
            "type": "number",
            "maximum": 10000.0,
            "minimum": -10000.0,
            "title": "Origin Y M"
          },
          "calibration": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PlanReferenceCalibration"
              },
              {
                "type": "null"
              }
            ]
          },
          "evidence": {
            "type": "string",
            "title": "Evidence",
            "default": "User calibration from a known distance; not surveyed"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "file_name",
          "media_type",
          "sha256",
          "width_px",
          "height_px",
          "meters_per_pixel",
          "origin_x_m",
          "origin_y_m"
        ],
        "title": "PlanReference",
        "description": "Background floor-plan image placed at scale; display aid only, never a solver input.\n\nThe image stays a local file: only its fingerprint travels in the project. Pixel (u, v),\nu to the right and v downwards from the top-left corner, maps to\nx = origin_x_m + u·meters_per_pixel and y = origin_y_m + v·meters_per_pixel."
      },
      "PlanReference-Output": {
        "properties": {
          "file_name": {
            "type": "string",
            "maxLength": 255,
            "minLength": 1,
            "title": "File Name"
          },
          "media_type": {
            "type": "string",
            "enum": [
              "image/png",
              "image/jpeg",
              "image/webp"
            ],
