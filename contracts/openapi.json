          },
          "evidence": {
            "type": "string",
            "title": "Evidence",
            "default": "User calibration from a known distance; not surveyed"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "file_name",
          "media_type",
          "sha256",
          "width_px",
          "height_px",
          "meters_per_pixel",
          "origin_x_m",
