{
  "$defs": {
    "AccessPointConnection": {
      "additionalProperties": false,
      "description": "Data path of a network device: its wireless hops and what the chain reaches. No verdict.",
      "properties": {
        "device_id": {
          "title": "Device Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "gateway",
            "wired",
            "wireless",
            "unknown",
            "undefined"
          ],
          "title": "Kind",
          "type": "string"
        },
        "hops": {
          "description": "Wireless links from this device towards the gateway, in order",
          "items": {
            "$ref": "#/$defs/BackhaulHop"
          },
          "title": "Hops",
          "type": "array"
        },
        "ends_at": {
          "enum": [
            "gateway",
            "wired",
            "unknown",
            "undefined",
            "loop"
          ],
          "title": "Ends At",
          "type": "string"
        },
        "end_device_id": {
          "description": "Last device reached; its connection is 'ends_at'",
          "title": "End Device Id",
          "type": "string"
        },
        "weakest_margin_db": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "Lowest hop margin; None without hops or if one is missing",
          "title": "Weakest Margin Db"
        },
        "reasons": {
          "items": {
            "type": "string"
          },
          "title": "Reasons",
          "type": "array"
        }
      },
      "required": [
        "device_id",
        "kind",
        "hops",
        "ends_at",
        "end_device_id",
        "weakest_margin_db",
        "reasons"
      ],
      "title": "AccessPointConnection",
      "type": "object"
    },
    "BackhaulHop": {
      "additionalProperties": false,
      "description": "One wireless link that carries an access point's data towards the gateway.",
      "properties": {
        "link_id": {
          "title": "Link Id",
          "type": "string"
        },
        "from_device_id": {
          "description": "Device whose data travels over this link",
          "title": "From Device Id",
          "type": "string"
        },
        "to_device_id": {
          "description": "Next device towards the gateway",
          "title": "To Device Id",
          "type": "string"
        },
        "status": {
          "description": "Status of the link in the same simulation",
          "title": "Status",
          "type": "string"
        },
        "limiting_margin_db": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "Lower margin of both directions; None if either is missing",
          "title": "Limiting Margin Db"
        }
      },
      "required": [
        "link_id",
        "from_device_id",
        "to_device_id",
        "status",
        "limiting_margin_db"
      ],
      "title": "BackhaulHop",
      "type": "object"
    },
    "ClassificationPolicy": {
      "additionalProperties": false,
      "description": "How coverage classes are assigned (B-139, decisions U1/U2); provisional until calibrated.",
      "properties": {
        "id": {
          "const": "coverage-class-v1",
          "title": "Id",
          "type": "string"
        },
        "design_reserve_db": {
          "description": "Limiting margin a favourable class needs, in dB",
          "title": "Design Reserve Db",
          "type": "number"
        },
        "rule": {
          "description": "The classification rule in plain words",
          "title": "Rule",
          "type": "string"
        },
        "failure_criterion": {
          "description": "Active test that decides whether a real link fails",
          "title": "Failure Criterion",
          "type": "string"
        },
        "calibrated": {
          "description": "False until measurements have fitted the reserve",
          "title": "Calibrated",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "design_reserve_db",
        "rule",
        "failure_criterion",
        "calibrated"
      ],
      "title": "ClassificationPolicy",
      "type": "object"
    },
    "DirectionResult": {
      "additionalProperties": false,
      "properties": {
        "tx_device_id": {
          "title": "Tx Device Id",
          "type": "string"
        },
        "rx_device_id": {
          "title": "Rx Device Id",
          "type": "string"
        },
        "distance_m": {
          "title": "Distance M",
          "type": "number"
        },
        "path_loss_db": {
          "title": "Path Loss Db",
          "type": "number"
        },
        "wall_loss_db": {
          "title": "Wall Loss Db",
          "type": "number"
        },
        "crossed_wall_ids": {
          "items": {
            "type": "string"
          },
          "title": "Crossed Wall Ids",
          "type": "array"
        },
        "received_power_dbm": {
          "title": "Received Power Dbm",
          "type": "number"
        },
        "noise_dbm": {
          "title": "Noise Dbm",
          "type": "number"
        },
        "snr_db": {
          "title": "Snr Db",
          "type": "number"
        },
        "margin_db": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Margin Db"
        }
      },
      "required": [
        "tx_device_id",
        "rx_device_id",
        "distance_m",
        "path_loss_db",
        "wall_loss_db",
        "crossed_wall_ids",
        "received_power_dbm",
        "noise_dbm",
        "snr_db",
        "margin_db"
      ],
      "title": "DirectionResult",
      "type": "object"
    },
    "LinkResult": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "compatibility": {
          "enum": [
            "radio-compatible",
            "incompatible",
            "unverified"
          ],
          "title": "Compatibility",
          "type": "string"
        },
        "status": {
          "enum": [
            "above-threshold",
            "below-threshold",
            "incompatible",
            "unverified",
            "unsupported"
          ],
          "title": "Status",
          "type": "string"
        },
        "forward": {
          "anyOf": [
            {
              "$ref": "#/$defs/DirectionResult"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "reverse": {
          "anyOf": [
            {
              "$ref": "#/$defs/DirectionResult"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "reasons": {
          "items": {
            "type": "string"
          },
          "title": "Reasons",
          "type": "array"
        },
        "coverage_class": {
          "anyOf": [
            {
              "enum": [
                "favourable",
                "marginal",
                "insufficient",
                "no-data"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "favourable / marginal / insufficient / no-data under the result's classification policy (B-139)",
          "title": "Coverage Class"
        },
        "limiting_margin_db": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Lower margin of both directions",
          "title": "Limiting Margin Db"
        },
        "worst_case_limiting_margin_db": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Same with every unknown door closed and uncertain material at its maximum loss; equals the nominal one when the direct path crosses no such wall",
          "title": "Worst Case Limiting Margin Db"
        }
      },
      "required": [
        "id",
        "compatibility",
        "status",
        "forward",
        "reverse",
        "reasons"
      ],
      "title": "LinkResult",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "engine": {
      "title": "Engine",
      "type": "string"
    },
    "engine_version": {
      "title": "Engine Version",
      "type": "string"
    },
    "input_hash": {
      "title": "Input Hash",
      "type": "string"
    },
    "elapsed_ms": {
      "title": "Elapsed Ms",
      "type": "number"
    },
    "scope": {
      "title": "Scope",
      "type": "string"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "links": {
      "items": {
        "$ref": "#/$defs/LinkResult"
      },
      "title": "Links",
      "type": "array"
    },
    "access_points": {
      "description": "Data path of every access point, router or bridge, and of any device with a data connection",
      "items": {
        "$ref": "#/$defs/AccessPointConnection"
      },
      "title": "Access Points",
      "type": "array"
    },
    "classification": {
      "anyOf": [
        {
          "$ref": "#/$defs/ClassificationPolicy"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Policy behind coverage_class"
    }
  },
  "required": [
    "engine",
    "engine_version",
    "input_hash",
    "elapsed_ms",
    "scope",
    "limitations",
    "links"
  ],
  "title": "SimulationResult",
  "type": "object"
}
